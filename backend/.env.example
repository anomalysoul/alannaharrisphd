# ── Dashboard Password ─────────────────────────────────────────────────────────
# Choose a strong password to protect the tracker dashboard
DASHBOARD_PASSWORD=changeme

# ── Session Secret ─────────────────────────────────────────────────────────────
# Random string used to sign session cookies (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-this-to-a-random-string

# ── Google OAuth2 (Gmail + Sheets) ─────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project, enable Gmail API and Google Sheets API
# 3. Create OAuth 2.0 credentials (Web application type)
# 4. Add http://localhost:3001/api/auth/google/callback as an Authorized redirect URI
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Your Gmail address (must match the Google account used for OAuth)
GMAIL_USER_EMAIL=your-email@gmail.com

# Display name shown in sent emails
EMAIL_FROM_NAME=Dr. Alanna Harris

# ── Google Sheets ──────────────────────────────────────────────────────────────
# 1. Create a Google Sheet at https://sheets.google.com
# 2. Copy the spreadsheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# 3. The app will automatically create the required tabs on first run
GOOGLE_SHEETS_ID=your-spreadsheet-id

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# URL where the frontend lives (used for CORS)
FRONTEND_URL=http://localhost:3001

# ── Weekly Outreach Schedule ───────────────────────────────────────────────────
# Cron expression for when to send weekly professor outreach emails
# Default: every Monday at 9:00 AM
OUTREACH_CRON=0 9 * * 1

# How many days must pass before re-contacting a professor
OUTREACH_INTERVAL_DAYS=7

# Max emails to send per outreach run (to avoid spam flags)
OUTREACH_BATCH_SIZE=10
